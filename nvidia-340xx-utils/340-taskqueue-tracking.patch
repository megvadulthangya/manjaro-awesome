+int NV_API_CALL nv_taskqueue_init(void)
+{
+    unsigned long flags;
+    int status = 0;
+
+    spin_lock_irqsave(&nv_taskqueue_state_lock, flags);
+
+    if (nv_taskqueue_accepting ||
+        atomic_read(&nv_taskqueue_pending) != 0)
+    {
+        status = -EBUSY;
+    }
+    else
+    {
+        nv_taskqueue_accepting = NV_TRUE;
+    }
+
+    spin_unlock_irqrestore(&nv_taskqueue_state_lock, flags);
+
+    return status;
+}
+
+void NV_API_CALL nv_taskqueue_shutdown(void)
+{
+    unsigned long flags;
+
+    for (;;)
+    {
+        wait_event(nv_taskqueue_wait_queue,
+                   atomic_read(&nv_taskqueue_pending) == 0);
+
+        spin_lock_irqsave(&nv_taskqueue_state_lock, flags);
+
+        if (atomic_read(&nv_taskqueue_pending) == 0)
+        {
+            nv_taskqueue_accepting = NV_FALSE;
+            spin_unlock_irqrestore(&nv_taskqueue_state_lock, flags);
+            break;
+        }
+
+        spin_unlock_irqrestore(&nv_taskqueue_state_lock, flags);
+    }
+}
+
+int NV_API_CALL nv_taskqueue_schedule(nv_task_t *work)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&nv_taskqueue_state_lock, flags);
+
+    if (!nv_taskqueue_accepting)
+    {
+        spin_unlock_irqrestore(&nv_taskqueue_state_lock, flags);
+        return 0;
+    }
+
+    atomic_inc(&nv_taskqueue_pending);
+
+    spin_unlock_irqrestore(&nv_taskqueue_state_lock, flags);
+
+    if (schedule_work(work))
+        return 1;
+
+    if (atomic_dec_and_test(&nv_taskqueue_pending))
+        wake_up(&nv_taskqueue_wait_queue);
+
+    return 0;
+}
+
+void NV_API_CALL nv_taskqueue_complete(void)
+{
+    if (atomic_dec_and_test(&nv_taskqueue_pending))
+        wake_up(&nv_taskqueue_wait_queue);
+}
+
+void NV_API_CALL nv_taskqueue_flush(void)
+{
+    wait_event(nv_taskqueue_wait_queue,
+               atomic_read(&nv_taskqueue_pending) == 0);
+}
