# Maintainer: Gyöngyösi Gábor <gabor at gshoots dot hu>
# upstream: Luca CPZ <luca.cpz [at] gmail [dot] com>
# Modified for local build from megvadulthangya/lain lua5.5-compatibility branch

_pkgname=lain
pkgname=$_pkgname-git
pkgver=r1801.c35b4a5
pkgrel=1
epoch=1
pkgdesc="Layouts, asynchronous widgets and utilities for Awesome WM (lua5.5-compat fork)"
arch=("any")
url="https://github.com/megvadulthangya/$_pkgname"
license=("GPL2")
depends=("awesome")
makedepends=("git")
optdepends=("curl: for IMAP, MPD and weather widgets")
provides=("$_pkgname")
conflicts=("$_pkgname")
# SKIP checksum for CI/CD compatibility
sha256sums=("SKIP")
# Use the fork with specific branch
source=("git+https://github.com/megvadulthangya/lain.git#branch=lua5.5-compatibility")

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$_pkgname"
    
    # Célkönyvtár meghatározása az Awesome WM struktúrában
    local _dest="$pkgdir/usr/share/awesome/lib/$_pkgname"
    
    # Telepítési könyvtár létrehozása
    install -dm755 "$_dest"
    
    # Teljes forrás másolása a célhelyre
    cp -ra . "$_dest/"
    
    # Takarítás: git metaadatok eltávolítása a csomagból
    rm -rf "$_dest/.git"
    rm -f "$_dest/.gitignore"
}
