pkgname=xnviewmp-old
pkgver=1.11.7
srcrel=1  # Incremented when there is a new release for the same version number
pkgrel=1
pkgdesc="An efficient multimedia viewer, browser and converter. (old version, testing older CPU compatibility)"
url="https://www.xnview.com/en/xnviewmp/"
arch=('x86_64')
license=('custom')
# Require qt6-multimedia to pull all its dependencies. We do not actually need
# to depend on qt6-*, but qt6-multimedia (and indirectly qt6-base) have
# various dependencies that we need even when using the packaged libraries.
depends=('qt6-multimedia')
optdepends=('glib2: support for moving files to trash')
# Prevent installation alongside the current xnviewmp package
conflicts=('xnviewmp')
provides=('xnviewmp')

source=("XnViewMP-linux-x64_${pkgver}-rel${srcrel}.tgz::https://download.xnview.com/old_versions/XnView_MP/XnView_MP-${pkgver}-linux-x64.tgz"
        'XnView.desktop')
sha256sums=('8a2f3f50986acae25f6b517829327c81de4005fc0487c139a08c163ebbe094ca'
            'f6b3a4aaa0a55b5f21d9b91ab6f3da3d6ee077ba7fdd17e7c4ab1c69ad2a9e3a')

package() {
  install -d -m755 "${pkgdir}/opt/xnviewmp"
  install -d -m755 "${pkgdir}/usr/bin"
  install -d -m755 "${pkgdir}/usr/share/applications"
  cp -a "${srcdir}/XnView"/* "${pkgdir}/opt/xnviewmp"
  ln -s "/opt/xnviewmp/xnview.sh" "${pkgdir}/usr/bin/xnviewmp"
  install -m644 "${srcdir}/XnView.desktop" "${pkgdir}/usr/share/applications/XnView.desktop"
  install -D -m644 "${srcdir}/XnView/license.txt" "${pkgdir}/usr/share/licenses/xnviewmp/LICENSE"

  # Clean up
  rm "${pkgdir}/opt/xnviewmp/XnView.desktop"
  chmod 644 "${pkgdir}/opt/xnviewmp"/xnview*.png
  chmod 755 "${pkgdir}/opt/xnviewmp/XnView"
}
# vim:set ts=2 sw=2 et
