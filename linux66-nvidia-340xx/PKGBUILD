# Contributor: Thomas Baechler <thomas@archlinux.org>

_linuxprefix=linux66   # <-- EZT cseréld a kívánt kernelre

pkgname="${_linuxprefix}-nvidia-340xx"
pkgver=340.108
pkgrel=1
pkgdesc="NVIDIA kernel modules for ${_linuxprefix}"
arch=('x86_64')
url="https://www.nvidia.com/"
license=('custom')
groups=("${_linuxprefix}-extramodules")
depends=("${_linuxprefix}" "nvidia-340xx-utils=${pkgver}")
makedepends=("${_linuxprefix}-headers" "nvidia-340xx-dkms=${pkgver}")
provides=("nvidia-340xx=${pkgver}" 'NVIDIA-MODULE')
options=(!strip)

build() {
    _kernver="$(cat /usr/src/${_linuxprefix}/version)"

    # Csak RT kerneleknél tedd be ezt a sort:
    # export IGNORE_PREEMPT_RT_PRESENCE=1
# --no-sign letiltja a Secure Boot aláírást, mert a csomagépítésnél nem szükséges
     sudo dkms build --no-sign --dkmstree "${srcdir}" -m nvidia/${pkgver} -k ${_kernver}

#    fakeroot dkms build --dkmstree "${srcdir}" -m nvidia/${pkgver} -k ${_kernver}


}

package() {
    _kernver="$(cat /usr/src/${_linuxprefix}/version)"

    install -Dt "${pkgdir}/usr/lib/modules/${_kernver}/extramodules" -m644 nvidia/${pkgver}/${_kernver}/${CARCH}/module/*.ko

    # compress each module individually
    find "$pkgdir" -name '*.ko' -exec zstd --rm -19 {} +

    install -Dm644 /usr/share/licenses/nvidia-340xx-dkms/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
