#!/usr/bin/bash
#
# linux-next-cleanup
#
# Removes obsolete linux-next kernel module directories and their
# DKMS database entries.
#
# IMPORTANT: This script does NOT invoke dkms(8). A `dkms remove -k <kernel>`
# call can trigger expensive module rebuilds or other blocking work. For
# cleaning up kernel versions that no longer exist on disk, removing the
# corresponding subdirectories under /var/lib/dkms/ is functionally
# equivalent and instantaneous.
#
# The list of obsolete kernel releases is maintained in STATE_FILE by the
# linux-next pre_upgrade scriptlet, which captures the kernelrelease that
# is on disk BEFORE pacman replaces the old package files.

set -u

STATE_FILE="/var/lib/linux-next/pending-cleanup"
KVER_FILE="/boot/linux-next-x86_64.kver"
MODULES_ROOT="/usr/lib/modules"
DKMS_ROOT="/var/lib/dkms"

log() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }

_valid_kernelrelease() {
    [[ "${1:-}" =~ ^[A-Za-z0-9._+-]+$ ]] &&
    [[ "${1:-}" != "." ]] &&
    [[ "${1:-}" != ".." ]]
}

# ---------------------------------------------------------------------------
# Nothing to do if there is no pending cleanup.
# ---------------------------------------------------------------------------
[[ -s "${STATE_FILE}" ]] || exit 0

# ---------------------------------------------------------------------------
# Resolve the currently installed kernelrelease.
# ---------------------------------------------------------------------------
if [[ ! -r "${KVER_FILE}" ]]; then
    warn "Cannot read current kernelrelease from ${KVER_FILE}. Cleanup skipped."
    exit 0
fi

if ! IFS=' ' read -r current_release _ < "${KVER_FILE}"; then
    warn "Cannot parse ${KVER_FILE}. Cleanup skipped."
    exit 0
fi

if ! _valid_kernelrelease "${current_release}"; then
    warn "Invalid current kernelrelease '${current_release}'. Cleanup skipped."
    exit 0
fi

# ---------------------------------------------------------------------------
# Verify pacman ownership database is functional before relying on it.
# ---------------------------------------------------------------------------
if ! /usr/bin/pacman -Qo /usr/bin/pacman >/dev/null 2>&1; then
    warn "Pacman ownership database unavailable. Cleanup skipped."
    exit 0
fi

# ---------------------------------------------------------------------------
# Process every obsolete kernelrelease recorded in the state file.
# ---------------------------------------------------------------------------
remaining=$(/usr/bin/mktemp "${STATE_FILE}.XXXXXX") || exit 1
trap '/usr/bin/rm -f -- "${remaining}"' EXIT

while IFS= read -r old_release || [[ -n "${old_release}" ]]; do
    [[ -n "${old_release}" ]] || continue

    if ! _valid_kernelrelease "${old_release}"; then
        warn "Invalid saved kernelrelease '${old_release}'. Retaining entry."
        printf '%s\n' "${old_release}" >> "${remaining}"
        continue
    fi

    # Never touch the currently installed kernel.
    if [[ "${old_release}" == "${current_release}" ]]; then
        continue
    fi

    old_dir="${MODULES_ROOT}/${old_release}"

    # Pacman may have already removed the directory during the upgrade.
    if [[ ! -d "${old_dir}" ]]; then
        log ">> Already removed: ${old_release}"
        continue
    fi

    # Verify the directory belongs to linux-next.
    if [[ ! -r "${old_dir}/pkgbase" ]] ||
       [[ "$(<"${old_dir}/pkgbase")" != "linux-next" ]]; then
        warn "Directory does not belong to linux-next: ${old_dir}. Retaining."
        printf '%s\n' "${old_release}" >> "${remaining}"
        continue
    fi

    # If pacman still owns the vmlinuz file, the package database has not
    # released the old files yet. Do not interfere with that state; the
    # next transaction (or the user) must resolve it.
    if /usr/bin/pacman -Qo "${old_dir}/vmlinuz" >/dev/null 2>&1; then
        warn "Files still owned by an installed package in ${old_dir}. Retaining."
        printf '%s\n' "${old_release}" >> "${remaining}"
        continue
    fi

    # -----------------------------------------------------------------------
    # Remove DKMS database entries for this kernel.
    # Path layout: /var/lib/dkms/<module>/<module-version>/<kernelrelease>/<arch>/
    # We delete the <kernelrelease> directory itself, which removes all
    # architecture subdirectories belonging to that kernel release.
    # -----------------------------------------------------------------------
    if [[ -d "${DKMS_ROOT}" ]]; then
        while IFS= read -r -d '' dkms_kdir; do
            log ">> Removing DKMS DB entry: ${dkms_kdir}"
            /usr/bin/rm -rf -- "${dkms_kdir}"
        done < <(
            /usr/bin/find "${DKMS_ROOT}" \
                -mindepth 3 -maxdepth 3 \
                -type d -name "${old_release}" -print0 2>/dev/null
        )
    fi

    # -----------------------------------------------------------------------
    # Remove the obsolete kernel module directory.
    # -----------------------------------------------------------------------
    log ">> Removing obsolete kernel directory: ${old_dir}"
    if ! /usr/bin/rm -rf -- "${old_dir}"; then
        warn "Failed to remove ${old_dir}. Retaining entry."
        printf '%s\n' "${old_release}" >> "${remaining}"
        continue
    fi
done < "${STATE_FILE}"

# ---------------------------------------------------------------------------
# Update the state file with any entries that could not be removed.
# ---------------------------------------------------------------------------
if [[ -s "${remaining}" ]]; then
    /usr/bin/sort -u -o "${remaining}" "${remaining}" || exit 1
    /usr/bin/mv -f -- "${remaining}" "${STATE_FILE}" || exit 1
else
    /usr/bin/rm -f -- "${STATE_FILE}" "${remaining}"
fi

trap - EXIT