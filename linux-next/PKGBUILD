  '!strip'
)

# =============================================================================
# MPATCH QUICK REFERENCE
# =============================================================================
# series.resolved is the only source of truth for patch activation and order.
# One patch filename per line; blank lines and lines beginning with # are ignored.
# An empty/comment-only series.resolved intentionally applies no patches.
#
# CLI: mpatch [OPTIONS] PATCH_FILE TARGET_DIRECTORY
#
# Upstream README sensitivity rules:
#   --fuzz-factor 0.0 : disables fuzzy matching; exact matching and a
#                       trailing-whitespace-insensitive exact pass remain.
#   --fuzz-factor 0.7 : default; permits approximate matching at default level.
#   --fuzz-factor 0.9 : permits more approximate matching when context has drifted.
# Raise the factor only after inspecting why the patch no longer matches.
# A successful fuzzy match does not prove that a kernel change is semantically safe.
#
# --dry-run previews changes without writing them.
# -vvvv requests verbose diagnostics and an mpatch-debug-report-*.md report.
# -R reverses a patch; it is for manual investigation, not normal builds.
#
# The failure wrapper reruns the failing patch with --dry-run and -vvvv, stores
# diagnostics below ${srcdir}/mpatch-debug/, and then fails prepare(). Each patch
# is a separate mpatch invocation; if a later patch fails, earlier patches may
# already have been applied. A clean rebuild must start from a fresh source tree.
# =============================================================================

# The selectable options are intentionally kept together here.
_mpatch_opts=(
    --atomic                # minden-vagy-semmi (build-hez kötelező)
    --fuzz-factor 0.7       # default hasonlósági küszöb
#     --fuzz-factor 0.9     # szigorúbb: kevesebb eltűrés, több bukás
#    --fuzz-factor 0.3     # lazább: csak debug célra!
#    --fuzz-factor 0.1
    # --fuzz-factor 0.0     # csak egzakt egyezés
#    --dry-run             # ne írjon, csak mutassa mit tenne
    # -vvvv                 # debug riport hiba esetén (a prepare() auto hívja)
    # -R                    # patch megfordítása (reverse-engineer)
    # -c                    # vágólapról olvas (build-hez nem kell)
    # -                     # stdin-ről olvas (build-hez nem kell)
)

_mpatch_debug_opts=(
  -vvvv
  --dry-run
)
_mpatch_debug_on_failure=1

source=(
  "${_source_tarball}::https://git.kernel.org/pub/scm/linux/kernel/git/next/linux-next.git/snapshot/linux-next-${_commit}.tar.gz"
  config
  series.resolved
  0001-add-sysctl-to-disallow-unprivileged-CLONE_NEWUSER-by.patch
  0002-drivers-firmware-skip-simpledrm-if-nvidia-drm.modese.patch
  0000-drm-amdgpu-fix-race-condition-in-amdgpu_vm_wait_idle-during-process-kill.patch
  0001-drm-amd-Sanity-check-custom-brightness-curve-data-po.patch
  0000-usb-vhci-hcd-Unconditionally-allow-system-suspend.patch
  0999-patch_realtek.patch
  0001-iio-imu-bmi270-Match-PNP-ID-found-on-newer-OrangePi-NEO-firmware.patch
  0001-zotac-zone-hid-initial-impl.patch
  0002-xpad-gate-the-zotac-zone-PID-behind-if-IS_REACHABLE-.patch
  0003-tmp-apply-zotac-screen-quirk.patch
  0005-zone-fix-6.15-rename-del_timer-to-timer_delete.patch
  0000-iwlwifi-fix.patch
)

