_basekernel=next
_basever=next
_kernelname=-MANJARO
_commit=2efb7a11f1aa4d2dc285fe2680cca22cb9f72f64
_commit_short=${_commit:0:12}
_rc=
pkgbase=linux-next
pkgrel=1
arch=('x86_64')
url='https://www.kernel.org/'
license=('GPL-2.0-only')

# Resolve immutable metadata for the pinned commit. Only _commit needs manual
# updating. The committer date is taken from the Gitiles JSON for this exact
# commit, never from the builder's wall clock.
if [[ ! "${_commit}" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'ERROR: _commit must be a full 40-character lowercase Git hash.\n' >&2
  exit 1
fi

_commit_metadata_url="https://kernel.googlesource.com/pub/scm/linux/kernel/git/next/linux-next/+/${_commit}?format=JSON"
if ! command -v curl >/dev/null 2>&1; then
  printf 'ERROR: curl is required to resolve the pinned linux-next commit date.\n' >&2
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  printf 'ERROR: python3 is required to parse the pinned linux-next commit metadata.\n' >&2
  exit 1
fi

_commit_json="$(curl --fail --silent --show-error --location \
  --connect-timeout 10 --max-time 30 --retry 2 \
  "${_commit_metadata_url}")" || {
  printf 'ERROR: could not retrieve Git metadata for linux-next commit %s.\n' "${_commit}" >&2
  printf 'ERROR: refusing to guess the commit date or use the current date.\n' >&2
  exit 1
}

_commit_metadata="$(python3 -c '
import datetime
import json
import sys

expected = sys.argv[1]
raw = sys.stdin.read()
if raw.startswith(")]}"):
    raw = raw.split("\n", 1)[1]
obj = json.loads(raw)
reported = obj.get("commit", "")
if reported and reported.lower() != expected.lower():
    raise SystemExit("Gitiles returned metadata for a different commit")
committer = obj.get("committer") or {}
value = committer.get("time")
if not value:
    raise SystemExit("Gitiles response has no committer timestamp")
dt = datetime.datetime.strptime(value, "%a %b %d %H:%M:%S %Y %z")
# Keep the date as recorded in the commit timezone; preserve the exact instant
# separately as SOURCE_DATE_EPOCH so builds are independent of local timezone.
print(dt.strftime("%Y%m%d"), int(dt.timestamp()))
' "${_commit}" <<< "${_commit_json}")" || {
  printf 'ERROR: could not parse Git commit metadata for %s.\n' "${_commit}" >&2
  exit 1
}

read -r _commit_date _commit_epoch <<< "${_commit_metadata}"
if [[ ! "${_commit_date}" =~ ^[0-9]{8}$ || ! "${_commit_epoch}" =~ ^[0-9]+$ ]]; then
  printf 'ERROR: invalid commit date metadata for %s: %s\n' "${_commit}" "${_commit_metadata}" >&2
  exit 1
fi

pkgver="${_commit_date}.r0.g${_commit_short}"
_source_tarball="linux-next-${_commit_date}-${_commit}.tar.gz"
_srcdir="linux-next-${_commit}"

makedepends=(
