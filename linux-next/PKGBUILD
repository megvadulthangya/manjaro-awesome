# Reproducible kernel build metadata: derived from the pinned commit, not build time.
export SOURCE_DATE_EPOCH="${_commit_epoch}"
export KBUILD_BUILD_VERSION=1
export KBUILD_BUILD_HOST=manjaro
export KBUILD_BUILD_USER="${pkgbase}"
export KBUILD_BUILD_TIMESTAMP="$(LC_ALL=C date -Ru -d "@${SOURCE_DATE_EPOCH}")"

_mpatch_apply() {
  local _patchfile="$1"
  local _targetdir="$2"
  local _patchname="${_patchfile##*/}"
  local _rc

  if mpatch "${_mpatch_opts[@]}" "${_patchfile}" "${_targetdir}"; then
    return 0
  else
    _rc=$?
  fi

  printf 'ERROR: mpatch failed (exit=%s): %s\n' "${_rc}" "${_patchname}" >&2

  if [[ "${_mpatch_debug_on_failure}" == '1' ]]; then
    local _dbgdir="${srcdir}/mpatch-debug"
    mkdir -p -- "${_dbgdir}"
    printf 'Generating mpatch diagnostics in %s\n' "${_dbgdir}" >&2

    (
      cd -- "${_targetdir}" || exit 1
      mpatch "${_mpatch_opts[@]}" "${_mpatch_debug_opts[@]}" "${_patchfile}" .
    ) > "${_dbgdir}/${_patchname}.diagnostic.log" 2>&1 || true

    while IFS= read -r -d '' _report; do
      mv -f -- "${_report}" "${_dbgdir}/${_patchname}.report.md"
    done < <(find "${_targetdir}" -maxdepth 1 -type f -name 'mpatch-debug-report-*.md' -print0 2>/dev/null)

    printf 'Review %s/%s.report.md and %s/%s.diagnostic.log\n' \
      "${_dbgdir}" "${_patchname}" "${_dbgdir}" "${_patchname}" >&2
  fi

  return "${_rc}"
}

prepare() {
  cd -- "${_srcdir}"

  printf '%s\n' "-${pkgrel}" > localversion.10-pkgrel
  cp -- "${srcdir}/config" .config

  if [[ ! -f "${srcdir}/series.resolved" ]]; then
    error 'series.resolved is missing from the PKGBUILD source directory.'
    return 1
  fi

  local -a _patches=()
  mapfile -t _patches < <(
    awk '
      {
        sub(/\r$/, "")
        sub(/^[[:space:]]+/, "")
        sub(/[[:space:]]+$/, "")
        if (length($0) > 0 && $0 !~ /^#/) print
      }
    ' "${srcdir}/series.resolved"
  )

  if (( ${#_patches[@]} == 0 )); then
    msg 'No patches enabled: series.resolved contains no active entries.'
  else
    if ! command -v mpatch >/dev/null 2>&1; then
      error 'mpatch is required because series.resolved enables patches.'
      return 1
    fi

    msg "Applying ${#_patches[@]} patch(es) in series.resolved order."
    local _patch
    local _patchfile
    local _index=0
    local _total=${#_patches[@]}

    for _patch in "${_patches[@]}"; do
      _index=$((_index + 1))

      if [[ "${_patch}" == */* || "${_patch}" == '.' || "${_patch}" == '..' ]]; then
        error "Invalid patch entry in series.resolved: ${_patch}"
        return 1
      fi

      _patchfile="${srcdir}/${_patch}"
      if [[ ! -f "${_patchfile}" ]]; then
        error "Patch listed in series.resolved is missing: ${_patchfile}"
        return 1
      fi

      msg "[${_index}/${_total}] ${_patch}"
      if ! _mpatch_apply "${_patchfile}" "${PWD}"; then
        error "Patch application failed: ${_patch}. See ${srcdir}/mpatch-debug/ if enabled."
        return 1
      fi
    done
  fi

  make olddefconfig
  diff -u "${srcdir}/config" .config || :
  make -s kernelrelease > version
  msg "Prepared ${pkgbase} version $(<version)"
}

build() {
  cd -- "${_srcdir}"
  make ${MAKEFLAGS} bzImage modules
  make -C tools/bpf/bpftool vmlinux.h feature-clang-bpf-co-re=1
}
package_linux-next() {
  pkgdesc='The Linux next kernel and modules'
  depends=('coreutils' 'initramfs' 'kmod')
  optdepends=(
    'linux-next-headers: headers and scripts for building modules'
    'linux-firmware: firmware images needed for some devices'
    'scx-scheds: to use sched-ext schedulers'
    'wireless-regdb: to set the correct wireless channels of your country'
  )
  provides=(
    "linux=${pkgver}"
    KSMBD-MODULE
    NTSYNC-MODULE
    VIRTUALBOX-GUEST-MODULES
    WIREGUARD-MODULE
  )
  replaces=('virtualbox-guest-modules' 'wireguard')

  cd -- "${_srcdir}"
  local modulesdir="${pkgdir}/usr/lib/modules/$(<version)"

  install -Dm644 "$(make -s image_name)" "${modulesdir}/vmlinuz"
  printf '%s\n' "${pkgbase}" | install -Dm644 /dev/stdin "${modulesdir}/pkgbase"
  printf '%s\n' "${_basekernel}-${CARCH}" | install -Dm644 /dev/stdin "${modulesdir}/kernelbase"

  install -d "${pkgdir}/boot"
  printf '%s x64\n' "$(<version)" > "${pkgdir}/boot/${pkgbase}-${CARCH}.kver"

  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="${pkgdir}/usr" INSTALL_MOD_STRIP=1 \
    DEPMOD=/doesnt/exist modules_install

  rm -f -- "${modulesdir}/build"
  depmod -b "${pkgdir}/usr" -F System.map "$(<version)"
}

package_linux-next-headers() {
  pkgdesc='Headers and scripts for building modules for the Linux next kernel'
  depends=('binutils' 'glibc' 'libelf' 'libgcc' 'openssl' 'pahole' 'xxhash' 'zlib' 'zstd')
  provides=('LINUX-HEADERS' "linux-next-headers=${pkgver}")

  cd -- "${_srcdir}"
  local builddir="${pkgdir}/usr/lib/modules/$(<version)/build"

  install -Dt "${builddir}" -m644 .config Makefile Module.symvers System.map \
    localversion.* version vmlinux tools/bpf/bpftool/vmlinux.h
  install -Dt "${builddir}/kernel" -m644 kernel/Makefile
  install -Dt "${builddir}/arch/x86" -m644 arch/x86/Makefile
  cp -t "${builddir}" -a scripts
  ln -srt "${builddir}" "${builddir}/scripts/gdb/vmlinux-gdb.py"

  install -Dt "${builddir}/tools/objtool" tools/objtool/objtool

  if [[ -f tools/bpf/resolve_btfids/resolve_btfids ]]; then
    install -Dt "${builddir}/tools/bpf/resolve_btfids" \
      tools/bpf/resolve_btfids/resolve_btfids
  fi

  cp -t "${builddir}" -a include
  cp -t "${builddir}/arch/x86" -a arch/x86/include
  install -Dt "${builddir}/arch/x86/kernel" -m644 arch/x86/kernel/asm-offsets.s

  install -Dt "${builddir}/drivers/md" -m644 drivers/md/*.h
  install -Dt "${builddir}/net/mac80211" -m644 net/mac80211/*.h
  install -Dt "${builddir}/drivers/media/i2c" -m644 drivers/media/i2c/msp3400-driver.h
  install -Dt "${builddir}/drivers/media/usb/dvb-usb" -m644 drivers/media/usb/dvb-usb/*.h
  install -Dt "${builddir}/drivers/media/dvb-frontends" -m644 drivers/media/dvb-frontends/*.h
  install -Dt "${builddir}/drivers/media/tuners" -m644 drivers/media/tuners/*.h
  install -Dt "${builddir}/drivers/iio/common/hid-sensors" \
    -m644 drivers/iio/common/hid-sensors/*.h

  find . -name 'Kconfig*' -exec install -Dm644 {} "${builddir}/{}" \;

  local _arch
  for _arch in "${builddir}"/arch/*/; do
    [[ -d "${_arch}" ]] || continue
    [[ "${_arch}" == "${builddir}/arch/x86/" ]] && continue
    rm -rf -- "${_arch}"
  done

  rm -rf -- "${builddir}/Documentation"
  find -L "${builddir}" -type l -printf 'Removing %P\n' -delete
  find "${builddir}" -type f -name '*.o' -printf 'Removing %P\n' -delete

  local _file
  while IFS= read -r -d '' _file; do
    case "$(file -Sib "${_file}")" in
      application/x-sharedlib\;*)       strip -v ${STRIP_SHARED} "${_file}" ;;
      application/x-archive\;*)         strip -v ${STRIP_STATIC} "${_file}" ;;
      application/x-executable\;*)      strip -v ${STRIP_BINARIES} "${_file}" ;;
      application/x-pie-executable\;*) strip -v ${STRIP_SHARED} "${_file}" ;;
    esac
  done < <(find "${builddir}" -type f -perm -u+x ! -name vmlinux -print0)

  strip -v ${STRIP_STATIC} "${builddir}/vmlinux"

  install -d "${pkgdir}/usr/src"
  ln -sr "${builddir}" "${pkgdir}/usr/src/${pkgbase}"
}

pkgname=(
  linux-next
  linux-next-headers
)
