# linux-next package installation scriptlet
#
# Records the currently installed kernelrelease before pacman replaces the
# old kernel package files. The actual cleanup is done by the PostTransaction
# hook (95-linux-next-cleanup.hook), which uses the recorded state.
#
# Package versions ($1 and $2) are intentionally not used because the
# PKGBUILD has a builder-managed static pkgver: the effective kernelrelease
# is captured from /boot/linux-next-x86_64.kver instead.

_ln_state_file="/var/lib/linux-next/pending-cleanup"
_ln_kver_file="/boot/linux-next-x86_64.kver"
_ln_modules_root="/usr/lib/modules"

pre_upgrade() {
    local old_release old_pkgbase saved_release
    local pkgbase_file

    # Read the actual kernelrelease currently installed on disk.
    if [[ ! -r "${_ln_kver_file}" ]]; then
        printf 'WARNING: Cannot read previous kernel version: %s\n' \
            "${_ln_kver_file}" >&2
        return 0
    fi

    if ! IFS=' ' read -r old_release _ < "${_ln_kver_file}"; then
        printf 'WARNING: Cannot determine previous kernelrelease.\n' >&2
        return 0
    fi

    # Validate the kernelrelease before using it as a filesystem path.
    if [[ ! "${old_release}" =~ ^[A-Za-z0-9._+-]+$ ]] ||
       [[ "${old_release}" == "." || "${old_release}" == ".." ]]; then
        printf 'WARNING: Invalid previous kernelrelease: %s\n' \
            "${old_release}" >&2
        return 0
    fi

    # Verify that the directory belongs to linux-next.
    pkgbase_file="${_ln_modules_root}/${old_release}/pkgbase"

    if [[ ! -r "${pkgbase_file}" ]]; then
        printf 'WARNING: Previous kernel pkgbase marker is missing: %s\n' \
            "${pkgbase_file}" >&2
        return 0
    fi

    if ! IFS= read -r old_pkgbase < "${pkgbase_file}"; then
        printf 'WARNING: Cannot read previous kernel pkgbase.\n' >&2
        return 0
    fi

    if [[ "${old_pkgbase}" != "linux-next" ]]; then
        printf 'WARNING: Previous kernel does not belong to linux-next: %s\n' \
            "${old_pkgbase}" >&2
        return 0
    fi

    # Create the persistent cleanup state directory.
    if ! /usr/bin/install -d -m 0755 /var/lib/linux-next; then
        printf 'WARNING: Cannot create linux-next cleanup directory.\n' >&2
        return 0
    fi

    # Create the state file if this is the first recorded upgrade.
    if [[ ! -e "${_ln_state_file}" ]]; then
        if ! /usr/bin/install -m 0644 /dev/null "${_ln_state_file}"; then
            printf 'WARNING: Cannot create cleanup state file.\n' >&2
            return 0
        fi
    elif [[ ! -f "${_ln_state_file}" ]]; then
        printf 'WARNING: Cleanup state path is not a regular file.\n' >&2
        return 0
    fi

    # Avoid registering the same kernelrelease twice.
    while IFS= read -r saved_release || [[ -n "${saved_release}" ]]; do
        if [[ "${saved_release}" == "${old_release}" ]]; then
            printf '>> Kernel already registered for cleanup: %s\n' \
                "${old_release}"
            return 0
        fi
    done < "${_ln_state_file}"

    # Register the previous kernelrelease for the PostTransaction hook.
    if ! printf '%s\n' "${old_release}" >> "${_ln_state_file}"; then
        printf 'WARNING: Failed to register previous kernelrelease: %s\n' \
            "${old_release}" >&2
        return 0
    fi

    printf '>> Registered previous kernel for cleanup: %s\n' \
        "${old_release}"
}