# Maintainer: Gyöngyösi Gábor <gabor at gshoots dot hu>
# Contributor: Igor <f2404@yandex.ru>
# Contributor: Davi da Silva Böger <dsboger at gmail dot com>
pkgname=tilix-git
pkgver=1.9.6.r72.g46b6a7c
pkgrel=2
pkgdesc="A tiling terminal emulator for Linux using GTK+ 3"
arch=('x86_64')
url="https://gnunn1.github.io/tilix-web"
license=('MPL-2.0')
depends=(
  'dconf'
  'gsettings-desktop-schemas'
  'gtkd'
  'liblphobos'
  'libx11'
  'vte3'
)
makedepends=(
  'git'
  'meson'
  'po4a'
  'curl'
  'tar'
)
checkdepends=(
  'appstream'
)
optdepends=(
  'python-nautilus: for "Open Tilix Here" support in nautilus'
  'libsecret: for the password manager'
)
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=('git+https://github.com/gnunn1/tilix.git')
sha256sums=('SKIP')

# Hordozható LDC 1.43.0 letöltése
_ldc_version="1.43.0"
_ldc_tarball="ldc2-${_ldc_version}-linux-x86_64.tar.xz"
_ldc_url="https://github.com/ldc-developers/ldc/releases/download/v${_ldc_version}/${_ldc_tarball}"

pkgver() {
  cd "${pkgname%-git}"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "${pkgname%-git}"

  # Patch Align to GtkAlign, due to conflicting symbols
  sed -i 's/(Align\./(GtkAlign./g' source/gx/tilix/prefeditor/prefdialog.d
  sed -i 's/(Align\./(GtkAlign./g' source/gx/tilix/terminal/terminal.d
}

build() {
  cd "$srcdir"

  # LDC bináris letöltése és kicsomagolása
  mkdir -p "$srcdir/ldc"
  cd "$srcdir/ldc"
  if [[ ! -f "$_ldc_tarball" ]]; then
    curl -L -O "$_ldc_url"
  fi
  tar xf "$_ldc_tarball"

  # Vissza a forráskönyvtárba
  cd "$srcdir"

  # Hordozható LDC környezet beállítása
  LDC_DIR="$srcdir/ldc/ldc2-${_ldc_version}-linux-x86_64"
  export PATH="$LDC_DIR/bin:$PATH"
  export DC="$LDC_DIR/bin/ldc2"
  export LD_LIBRARY_PATH="$LDC_DIR/lib:$LD_LIBRARY_PATH"

  # Távolítsuk el az LDC által nem ismert linker kapcsolókat
  export LDFLAGS="$(echo "$LDFLAGS" | sed -e 's/-flto=auto//g' -e 's/-Wl,[^ ]*//g')"

  # D futásidejű könyvtárak: dinamikus linkelés
  export DFLAGS="--flto=full --allinst -link-defaultlib-shared"

  arch-meson "${pkgname%-git}" build
  meson compile -C build
}

check() {
  # A hordozható LDC környezet beállítása a tesztekhez is szükséges
  LDC_DIR="$srcdir/ldc/ldc2-${_ldc_version}-linux-x86_64"
  export PATH="$LDC_DIR/bin:$PATH"
  export LD_LIBRARY_PATH="$LDC_DIR/lib:$LD_LIBRARY_PATH"

  # Tesztek futtatása
  meson test -C build --no-rebuild --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"

  # A szükséges D futásidejű könyvtárak szimbolikus linkjeinek létrehozása
  mkdir -p "$pkgdir/usr/lib"
  ln -s libphobos2-ldc-shared.so.113 "$pkgdir/usr/lib/libphobos2-ldc-shared.so.112"
  ln -s libdruntime-ldc-shared.so.113 "$pkgdir/usr/lib/libdruntime-ldc-shared.so.112"
}
