Subject: [PATCH] backport strncpy changes from 580.178.04 (uvm part)

---
 nvidia-uvm/uvm8_pmm_gpu.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/nvidia-uvm/uvm8_pmm_gpu.c b/nvidia-uvm/uvm8_pmm_gpu.c
index 6f0857e4..8d2a0d61 100644
--- a/nvidia-uvm/uvm8_pmm_gpu.c
+++ b/nvidia-uvm/uvm8_pmm_gpu.c
@@ -2794,7 +2794,10 @@ NV_STATUS init_chunk_split_cache_level(uvm_pmm_gpu_t *pmm, size_t level)
             size_t size;
             size_t align;
             if (level == 0) {
-                strncpy(chunk_split_cache[level].name, "uvm_gpu_chunk_t", sizeof(chunk_split_cache[level].name) - 1);
+                snprintf(chunk_split_cache[level].name,
+                         sizeof(chunk_split_cache[level].name),
+                         "uvm_gpu_chunk_t");
+
                 size = sizeof(uvm_gpu_chunk_t);
                 align = __alignof__(uvm_gpu_chunk_t);
             } else {
