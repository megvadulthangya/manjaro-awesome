+        dma_fence_init_has_flags)
+            #
+            # Determine if dma_fence_init() accepts the flags argument.
+            #
+            CODE="
+            #if !defined(NV_LINUX_FENCE_H_PRESENT)
+            #include <linux/dma-fence.h>
+            #include <linux/spinlock.h>
+            void conftest_dma_fence_init_has_flags(
+                struct dma_fence *fence,
+                const struct dma_fence_ops *ops,
+                spinlock_t *lock)
+            {
+                dma_fence_init(fence, ops, lock, 0, 0, 0UL);
+            }
+            #else
+            #error legacy fence API does not use dma_fence_init()
+            #endif"
+
+            compile_check_conftest "$CODE" "NV_DMA_FENCE_INIT_HAS_FLAGS" "" "types"
+        ;;
+
         proc_ops)
