+int NV_API_CALL nv_workqueue_init(void)
+{
+    unsigned long flags;
+    int status = 0;
+
+    spin_lock_irqsave(&nv_workqueue_state_lock, flags);
+
+    if (nv_workqueue_accepting ||
+        atomic_read(&nv_workqueue_pending) != 0)
+    {
+        status = -EBUSY;
+    }
+    else
+    {
+        nv_workqueue_accepting = NV_TRUE;
+    }
+
+    spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+
+    return status;
+}
+
+void NV_API_CALL nv_workqueue_shutdown(void)
+{
+    unsigned long flags;
+
+    for (;;)
+    {
+        wait_event(nv_workqueue_wait_queue,
+                   atomic_read(&nv_workqueue_pending) == 0);
+
+        spin_lock_irqsave(&nv_workqueue_state_lock, flags);
+
+        if (atomic_read(&nv_workqueue_pending) == 0)
+        {
+            nv_workqueue_accepting = NV_FALSE;
+            spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+            break;
+        }
+
+        spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+    }
+}
+
+int NV_API_CALL nv_workqueue_schedule(nv_task_t *work)
+{
+    unsigned long flags;
+
+    spin_lock_irqsave(&nv_workqueue_state_lock, flags);
+
+    if (!nv_workqueue_accepting)
+    {
+        spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+        return 0;
+    }
+
+    atomic_inc(&nv_workqueue_pending);
+
+    spin_unlock_irqrestore(&nv_workqueue_state_lock, flags);
+
+    if (schedule_work(work))
+        return 1;
+
+    if (atomic_dec_and_test(&nv_workqueue_pending))
+        wake_up(&nv_workqueue_wait_queue);
+
+    return 0;
+}
+
+void NV_API_CALL nv_workqueue_complete(void)
+{
+    if (atomic_dec_and_test(&nv_workqueue_pending))
+        wake_up(&nv_workqueue_wait_queue);
+}
+
+void NV_API_CALL nv_workqueue_flush(void)
+{
+    wait_event(nv_workqueue_wait_queue,
+               atomic_read(&nv_workqueue_pending) == 0);
+}
