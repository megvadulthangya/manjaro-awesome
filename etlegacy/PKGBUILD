# Maintainer: Aciz <...>
# Full 64 bit ET:Legacy clients can only connect to ET:Legacy servers running mods providing a 64 bit version.
# If you want to connect to existing 32 bit only mods, install the cross-compiled "etlegacy32" package instead.
# The engine is dynamically compiled, while the official precompiled mod libraries are provided.
#
# NOTE: A `pkgbase` sor szándékosan ki van kommentelve. A Hokibot ugyanis a
# `pkgbase=etlegacy` alapján próbálja prefix-levágással párosítani az
# artifactokat, és mivel az `etlegacy` prefixe az `etlegacy-mod`-nak,
# összekeveri őket (mod-2.86.0-1 lesz az etlegacy verziója). Ha a pkgbase
# nincs deklarálva, a builder minden pkgname-t külön kezel, és nincs gond.

#pkgbase=etlegacy
pkgname=('etlegacy' 'etlegacy-mod')

# Dummy érték, a pkgver() úgyis felülírja. A builder hiába írja bele a
# legutóbb buildelt verziót, mi nem használjuk sehol, mert minden a _ver
# változóra épül.
pkgver=2.86.0
pkgrel=1

# Ezeket a builder nem ismeri, ezért nem írja felül. A legfrissebb stabil
# git tag lekérése a GitHub API-ról, fallback a 2.84.0-ra.
_ver=$(curl -s --max-time 15 "https://api.github.com/repos/etlegacy/etlegacy/tags" 2>/dev/null \
       | grep -oP '"name":\s*"v?\K[0-9]+\.[0-9]+\.[0-9]+' \
       | sort -V | tail -1)
: "${_ver:=2.84.0}"

# A legfrissebb stabil bináris azonosító a letöltési oldalról, fallback 715.
_bver=$(curl -sL --max-time 15 https://www.etlegacy.com/download 2>/dev/null \
        | grep -oP 'file/\K[0-9]+' \
        | sort -n | tail -1)
: "${_bver:=715}"

# Belső használatú azonosító az URL-ekhez és az útvonalakhoz. A builder
# ezt nem bántja, mert underscore prefixe van.
_pkgbase=etlegacy

arch=('x86_64' 'aarch64')
url="http://www.etlegacy.com/"
license=('GPL3' 'custom')
makedepends=('cmake' 'zip' 'alsa-lib' 'curl' 'freetype2' 'gcc-libs' 'glew'
             'libjpeg-turbo' 'libvorbis' 'libtheora' 'minizip' 'openal>=1.14'
             'sdl2' 'cjson')

source=("${_pkgbase}-${_ver}.tar.gz::https://github.com/etlegacy/${_pkgbase}/archive/v${_ver}.tar.gz"
        "${_pkgbase}-binary-${_bver}.tar.gz::https://www.etlegacy.com/download/file/${_bver}")

# Dinamikus verzióknál nincs értelme statikus hash-nek. A HTTPS + megbízható
# forrás az elsődleges védelem.
sha256sums=('SKIP' 'SKIP')

# A tényleges csomagverziót itt adjuk vissza. Ez felülírja a fájl elején
# lévő dummy pkgver=0-t, és a builder által beírt értéket is.
pkgver() {
    echo "$_ver"
}

build() {
    cd "$_pkgbase-$_ver"

    export CFLAGS="-march=x86-64 -mtune=generic -O2 -pipe -fno-plt -fexceptions \
        -Wp,-D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security \
        -fstack-clash-protection -fcf-protection \
        -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer"
    export CXXFLAGS="$CFLAGS -Wp,-D_GLIBCXX_ASSERTIONS"

    cmake . ${cmakeopts[@]} \
        -DCMAKE_LIBRARY_PATH=/usr/lib \
        -DCROSS_COMPILE32=0 \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DINSTALL_DEFAULT_BASEDIR=/usr/lib/etlegacy \
        -DINSTALL_DEFAULT_BINDIR=bin \
        -DINSTALL_DEFAULT_MODDIR=lib/etlegacy \
        -DBUILD_SERVER=1 \
        -DBUILD_CLIENT=1 \
        -DBUILD_MOD=0 \
        -DBUILD_MOD_PK3=0 \
        -DBUNDLED_LIBS=0 \
        -DFEATURE_AUTOUPDATE=0 \
        -DINSTALL_OMNIBOT=0

    make
}

package_etlegacy() {
    pkgdesc="Wolfenstein: Enemy Territory 2.60b compatible client/server (etlegacy engine)"
    depends=('etlegacy-mod' 'alsa-lib' 'curl' 'freetype2' 'gcc-libs' 'glew' 'libjpeg-turbo' 'libvorbis' 'lua' 'minizip' 'openal' 'sdl2')
    provides=('etlegacy')
    conflicts=('etlegacy')
    backup=('etc/xdg/etlegacy/etmain/etl_server.cfg'
            'etc/xdg/etlegacy/etmain/legacy.cfg'
            'etc/xdg/etlegacy/etmain/campaigncycle.cfg'
            'etc/xdg/etlegacy/etmain/lmscycle.cfg'
            'etc/xdg/etlegacy/etmain/mapvotecycle.cfg'
            'etc/xdg/etlegacy/etmain/objectivecycle.cfg')
    install=etlegacy.install

    cd "$_pkgbase-$_ver"

    # engine
    make DESTDIR="$pkgdir/" install

    # mod
    rm -rf "$pkgdir/usr/lib/$_pkgbase/legacy"

    # assets
    ln -s /usr/share/enemy-territory/etmain/{pak0,pak1,pak2}.pk3 "$pkgdir/usr/lib/$_pkgbase/etmain/"

    # doc
    mkdir -p "$pkgdir/usr/share/doc/$_pkgbase"
    install -m 644 VERSION.txt "$pkgdir/usr/share/doc/$_pkgbase/"
    install -m 644 ./*.md "$pkgdir/usr/share/doc/$_pkgbase/"
    install -m 644 docs/game/anticheat.html "$pkgdir/usr/share/doc/$_pkgbase/"

    # license
    mkdir -p "$pkgdir/usr/share/licenses/$_pkgbase"
    install -m 644 COPYING.txt "$pkgdir/usr/share/licenses/$_pkgbase/LICENSE"

    # systemd
    mkdir -p "$pkgdir/etc/xdg/$_pkgbase/etmain"
    mkdir -p "$pkgdir/usr/lib/systemd/system"
    install -m 644 misc/etlegacy.conf "$pkgdir/etc/xdg/$_pkgbase/"
    install -m 644 misc/etlegacy.x86_64.service "$pkgdir/usr/lib/systemd/system/etlegacy.service"

    # config
    mv "$pkgdir"/usr/lib/$_pkgbase/etmain/*.cfg "$pkgdir/etc/xdg/$_pkgbase/etmain/"
    ln -s /etc/xdg/$_pkgbase/etmain/{etl_server,legacy,{campaign,lms,mapvote,objective}cycle}.cfg "$pkgdir/usr/lib/$_pkgbase/etmain/"

    # server
    mkdir -p "$pkgdir/var/lib/$_pkgbase-server"
    ln -s /etc/xdg/$_pkgbase/etmain "$pkgdir/var/lib/$_pkgbase-server/"
}

package_etlegacy-mod() {
    pkgdesc="Wolfenstein: Enemy Territory 2.60b compatible client/server (etlegacy mod)"
    depends=('enemy-territory-data' 'geoip-database')
    optdepends=('etlegacy-omnibot: artificial intelligence (AI) controlled opponent'
                'geoip-database: GeoLite country geolocation database')

    # Nem a tarball belső könyvtárnevére keresünk (ami verzióról verzióra
    # változhat), hanem közvetlenül a legacy_v*.pk3 fájlra. Így teljesen
    # függetlenek vagyunk a bináris csomag belső szerkezetétől.
    local bindir
    bindir=$(find "$srcdir" -maxdepth 4 -type f -name 'legacy_v*.pk3' -printf '%h\n' 2>/dev/null | head -n1)

    if [[ -z $bindir ]]; then
        error "Nincs legacy_v*.pk3 a \$srcdir-ben"
        error "A \$srcdir tartalma:"
        find "$srcdir" -maxdepth 3 -mindepth 1 | sed 's/^/  /' >&2
        return 1
    fi

    msg "Mod fájlok itt: $bindir"

    mkdir -p "$pkgdir/usr/lib/$_pkgbase/legacy"
    install -m 644 "$bindir"/legacy_v*.pk3 "$pkgdir/usr/lib/$_pkgbase/legacy/"

    local qagame
    qagame=$(find "$srcdir" -maxdepth 4 -type f -name 'qagame.mp.x86_64.so' 2>/dev/null | head -n1)
    if [[ -z $qagame ]]; then
        error "Nincs qagame.mp.x86_64.so a \$srcdir-ben"
        return 1
    fi
    install -m 644 "$qagame" "$pkgdir/usr/lib/$_pkgbase/legacy/"

    # geoip
    ln -s /usr/share/GeoIP/GeoIP.dat "$pkgdir/usr/lib/$_pkgbase/legacy"
}