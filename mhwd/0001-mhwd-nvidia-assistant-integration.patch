+std::string Mhwd::getNvidiaAssistantConfig()
+{
+    const std::string command = "nvidia-driver-assistant --mhwd-config";
+    FILE* fp = popen(command.c_str(), "r");
+    if (nullptr == fp)
+    {
+        return {};
+    }
+
+    char buffer[128] = {};
+    std::string configName;
+    if (nullptr != fgets(buffer, sizeof(buffer), fp))
+    {
+        configName = buffer;
+    }
+
+    const int status = pclose(fp);
+    if (-1 == status || !WIFEXITED(status) || 0 != WEXITSTATUS(status))
+    {
+        return {};
+    }
+
+    const std::size_t endpos = configName.find_last_not_of(" \n\r\t");
+    if (std::string::npos == endpos)
+    {
+        return {};
+    }
+    configName.erase(endpos + 1);
+
+    if ("video-nvidia" != configName
+            && 0 != configName.compare(0, 13, "video-nvidia-"))
+    {
+        return {};
+    }
+
+    if (getNvidiaConfigBranch(configName).empty())
+    {
+        return {};
+    }
+
+    return configName;
+}
+
+std::string Mhwd::getNvidiaConfigBranch(const std::string& configName) const
+{
+    const std::size_t marker = configName.find("-nvidia");
+    if (std::string::npos == marker)
+    {
+        return {};
+    }
+
+    const std::size_t branchToken = marker + 7;
+    if (branchToken == configName.size()
+            || (branchToken + 6 == configName.size()
+                    && 0 == configName.compare(branchToken, 6, "-prime")))
+    {
+        return "current";
+    }
+
+    if (branchToken >= configName.size() || '-' != configName[branchToken])
+    {
+        return {};
+    }
+
+    const std::size_t digitsStart = branchToken + 1;
+    const std::size_t suffix = configName.find("xx", digitsStart);
+    if (std::string::npos != suffix && suffix > digitsStart
+            && (suffix + 2 == configName.size() || '-' == configName[suffix + 2])
+            && std::all_of(configName.begin() + digitsStart, configName.begin() + suffix,
+                    [](unsigned char c) { return std::isdigit(c); }))
+    {
+        return configName.substr(digitsStart, suffix - digitsStart);
+    }
+
+    return {};
+}
