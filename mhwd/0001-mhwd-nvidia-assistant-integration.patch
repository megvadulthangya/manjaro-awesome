+std::string Mhwd::getNvidiaAssistantConfig()
+{
+    if (nvidiaAssistantQueried_)
+    {
+        return nvidiaAssistantCache_;
+    }
+    nvidiaAssistantQueried_ = true;
+
+    FILE* fp = popen("nvidia-driver-assistant --mhwd-config 2>/dev/null", "r");
+    if (nullptr == fp)
+    {
+        return nvidiaAssistantCache_;
+    }
+
+    char buf[256];
+    if (nullptr != fgets(buf, sizeof(buf), fp))
+    {
+        nvidiaAssistantCache_ = buf;
+        std::size_t endpos = nvidiaAssistantCache_.find_last_not_of(" \n\r\t");
+        if (std::string::npos != endpos)
+        {
+            nvidiaAssistantCache_.erase(endpos + 1);
+        }
+        else
+        {
+            nvidiaAssistantCache_.clear();
+        }
+    }
+    pclose(fp);
+    return nvidiaAssistantCache_;
+}
